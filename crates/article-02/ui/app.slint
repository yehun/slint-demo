import { Button, LineEdit } from "std-widgets.slint";

// 嵌入中文字体, 解决 Android 中文乱码
import "../../../assets/fonts/MiSans-Regular.ttf";

export component MainWindow inherits Window {
    title: "Slint Demo - 三端初始化";
    min-width: 360px;
    min-height: 240px;
    preferred-width: 600px;
    preferred-height: 400px;
    default-font-family: "MiSans";

    in-out property <int> counter: 0;
    in property <string> counter_text: "计数: " + counter;
    in-out property <string> input_text: "";

    changed input_text => {
        if input_text.is-empty {
            hello_text.text = "Hello Slint!";
        } else {
            hello_text.text = "Hello " + input_text + "!";
        }
    }

    Rectangle {
        width: 100%;
        height: 100%;
        
        VerticalLayout {
            alignment: center;

            HorizontalLayout {
                alignment: center;

                VerticalLayout {
                    // max-width: 600px;

                    padding: 24px;
                    spacing: 16px;

                    // --- 固定高度: 标题区 ---

                    hello_text := Text {
                        text: "Hello Slint!";
                        font-size: 28px;
                        horizontal-alignment: center;
                    }

                    Text {
                        text: counter_text;
                        font-size: 18px;
                        horizontal-alignment: center;
                    }

                    // --- 固定高度: 按钮组 ---

                    HorizontalLayout {
                        alignment: center;
                        spacing: 12px;

                        Button {
                            text: "点击 +1";
                            clicked => {
                                root.counter += 1;
                            }
                        }

                        Button {
                            text: "重置";
                            clicked => {
                                root.counter = 0;
                            }
                        }
                    }

                    // --- 固定高度: 输入框 ---

                    LineEdit {
                        placeholder-text: "输入点什么...";
                        text <=> root.input_text;
                    }
                }
            }
        }
    }
}
