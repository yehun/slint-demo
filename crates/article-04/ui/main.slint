import { Button, LineEdit } from "std-widgets.slint";

export component MainWindow inherits Window {
    no-frame: true;
    preferred-width: 600px;
    preferred-height: 450px;
    min-width: 360px;
    min-height: 280px;
    background: #1e1e1e;
    title: "Slint 窗口居中 Demo";
    default-font-family: "MiSans";
    resize-border-width: 6px;

    in-out property <bool> is-maximized: false;
    in-out property <string> monitor-info: "加载中...";
    in-out property <string> status-text: "窗口已居中";

    // 回调 — Rust 侧实现
    callback close-window();
    callback move-window();
    callback min-window(minimized: bool);
    callback max-window(maximized: bool);
    callback center-window();
    callback recover-window();
    callback query-monitors() -> string;

    // 标题栏拖动状态
    private property <bool> enable-move: false;

    VerticalLayout {
        // === 标题栏 ===
        Rectangle {
            height: 32px;
            background: #2d2d2d;

            TouchArea {
                width: 100%;
                height: 100%;
                moved => {
                    if (root.enable-move) {
                        root.move-window();
                    }
                }
                pointer-event(event) => {
                    if (event.button == PointerEventButton.left) {
                        root.enable-move = event.kind == PointerEventKind.down;
                    }
                }
                double-clicked => {
                    root.max-window(!root.is-maximized);
                }
            }

            Text {
                x: 12px;
                text: root.title;
                color: white;
                font-size: 14px;
                vertical-alignment: center;
            }

            HorizontalLayout {
                alignment: end;

                // 最小化
                Rectangle {
                    width: 46px;
                    height: 32px;
                    background: min-touch.has-hover ? #444 : transparent;
                    min-touch := TouchArea {
                        width: 100%;
                        height: 100%;
                        clicked => { root.min-window(true); }
                    }
                    Text {
                        text: "—";
                        color: white;
                        font-size: 16px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        width: 100%;
                        height: 100%;
                    }
                }

                // 最大化/还原
                Rectangle {
                    width: 46px;
                    height: 32px;
                    background: max-touch.has-hover ? #444 : transparent;
                    max-touch := TouchArea {
                        width: 100%;
                        height: 100%;
                        clicked => { root.max-window(!root.is-maximized); }
                    }
                    Text {
                        text: root.is-maximized ? "❐" : "□";
                        color: white;
                        font-size: 16px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        width: 100%;
                        height: 100%;
                    }
                }

                // 关闭
                Rectangle {
                    width: 46px;
                    height: 32px;
                    background: close-touch.has-hover ? #e81123 : transparent;
                    close-touch := TouchArea {
                        width: 100%;
                        height: 100%;
                        clicked => { root.close-window(); }
                    }
                    Text {
                        text: "✕";
                        color: white;
                        font-size: 14px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        width: 100%;
                        height: 100%;
                    }
                }
            }
        }

        // === 内容区 ===
        Rectangle {
            vertical-stretch: 1;
            background: #1e1e1e;

            VerticalLayout {
                padding: 24px;
                spacing: 16px;

                Text {
                    text: "第四幕: 窗口居中与多显示器适配";
                    color: white;
                    font-size: 22px;
                    horizontal-alignment: center;
                }

                Text {
                    text: "DPI 缩放 · 多屏坐标 · off-screen 检测";
                    color: #aaaaaa;
                    font-size: 14px;
                    horizontal-alignment: center;
                }

                // 操作按钮
                HorizontalLayout {
                    alignment: center;
                    spacing: 12px;
                    vertical-stretch: 0;

                    Button {
                        text: "居中窗口";
                        height: 36px;
                        clicked => {
                            root.center-window();
                            root.status-text = "窗口已居中";
                        }
                    }

                    Button {
                        text: "恢复到主屏";
                        height: 36px;
                        clicked => {
                            root.recover-window();
                            root.status-text = "已恢复到主显示器";
                        }
                    }

                    Button {
                        text: "查询显示器";
                        height: 36px;
                        clicked => {
                            root.monitor-info = root.query-monitors();
                            root.status-text = "已刷新显示器信息";
                        }
                    }
                }

                // 显示器信息区
                Rectangle {
                    background: #2a2a2a;
                    border-radius: 6px;
                    vertical-stretch: 1;

                    VerticalLayout {
                        padding: 16px;
                        spacing: 8px;

                        Text {
                            text: "显示器信息";
                            color: #cccccc;
                            font-size: 14px;
                            font-weight: 700;
                        }

                        Text {
                            text: root.monitor-info;
                            color: #999999;
                            font-size: 13px;
                            wrap: word-wrap;
                        }
                    }
                }

                // 状态栏
                Text {
                    text: root.status-text;
                    color: #666666;
                    font-size: 12px;
                    horizontal-alignment: center;
                }
            }
        }
    }
}
