// 自定义按钮组件 — 不依赖 Material 样式, 直接控制颜色和字体
// std-widgets 的 Button 需要 MaterialPalette/MaterialFontSettings, 无样式时文字透明

export component Button inherits Rectangle {
    in property <string> text: "";
    in property <bool> enabled: true;
    in property <length> font-size: 14px;

    callback clicked;

    // 可配置样式
    property <brush> bg-default: #4f46e5;
    property <brush> bg-hover: #4338ca;
    property <brush> bg-pressed: #3730a3;
    property <brush> bg-disabled: #9ca3af;
    property <brush> text-color: #ffffff;
    property <brush> text-color-disabled: #d1d5db;
    property <length> padding-h: 16px;

    height: 36px;
    border-radius: 6px;

    background: root.enabled ? (root.pressed ? root.bg-pressed : (root.has-hover ? root.bg-hover : root.bg-default)) : root.bg-disabled;

    touch-area := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
        changed has-hover => { root.has-hover = self.has-hover; }
        changed pressed => { root.pressed = self.pressed; }
    }

    Text {
        x: root.padding-h;
        y: 0px;
        width: parent.width - root.padding-h * 2;
        height: parent.height;
        text: root.text;
        color: root.enabled ? root.text-color : root.text-color-disabled;
        font-size: root.font-size;
        font-weight: 500;
        vertical-alignment: center;
        horizontal-alignment: center;
        overflow: elide;
        z: 10;
    }

    // 内部状态
    property <bool> has-hover: false;
    property <bool> pressed: false;
}
