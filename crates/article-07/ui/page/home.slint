
import { Button } from "std-widgets.slint";

export component HomePage inherits Rectangle {


    in-out property <float> swipe-indicator-opacity: 0.0;
    in-out property <float> swipe-indicator-offset: 0.0;

    background: #fafafa;

    HorizontalLayout {
        alignment: center;

        VerticalLayout {
            padding: 24px;
            padding-top: 60px;
            spacing: 16px;
            alignment: center;

            // 滑动卡片 (随手势移动)
            Rectangle {
                width: 280px;
                height: 200px;
                background: #ffffff;
                border-radius: 12px;
                border-width: 1px;
                border-color: #e0e0e0;

                x: (parent.width - self.width) / 2 + root.swipe-indicator-offset * 0.5 * 1px;

                VerticalLayout {
                    padding: 20px;
                    spacing: 12px;
                    alignment: center;

                    Text {
                        text: "👆 滑动卡片";
                        font-size: 22px;
                        font-weight: 700;
                        color: #1a73e8;
                        horizontal-alignment: center;
                    }

                    Text {
                        text: "用手指或鼠标\n左右拖动此区域";
                        font-size: 14px;
                        color: #666;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    Text {
                        text: "SwipeGestureHandler";
                        font-size: 12px;
                        color: #999;
                        horizontal-alignment: center;
                    }
                }
            }

            // 滑动方向提示
            HorizontalLayout {
                spacing: 24px;
                alignment: center;

                Text {
                    text: "← 右滑";
                    font-size: 16px;
                    color: #aaa;
                }

                Text {
                    text: "|";
                    font-size: 16px;
                    color: #ddd;
                }

                Text {
                    text: "左滑 →";
                    font-size: 16px;
                    color: #aaa;
                }
            }

            // 属性面板
            Rectangle {
                width: 300px;
                height: 100px;
                background: #f0f4ff;
                border-radius: 8px;

                VerticalLayout {
                    padding: 12px;
                    spacing: 6px;

                    Text {
                        text: "SwipeGestureHandler 属性";
                        font-size: 13px;
                        font-weight: 600;
                        horizontal-alignment: center;
                        color: #333;
                    }

                    Text {
                        text: "handle_swipe_left: true\nhandle_swipe_right: true\nswiped / moved / cancelled";
                        font-size: 11px;
                        horizontal-alignment: center;
                        color: #666;
                    }
                }
            }
        }
    }
}

